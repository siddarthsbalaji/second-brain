# Set to false only for local Postgres without SSL
# openssl rand -base64 32 (or similar); must be >=32 chars
JWT_SECRET=
# Comma-separated browser origins (Vercel preview + prod)
FRONTEND_ORIGINS=http://localhost:5173
PORT=5000

# Firebase Admin SDK Configuration (Firebase Console -> Project Settings -> Service Accounts -> Generate New Private Key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
